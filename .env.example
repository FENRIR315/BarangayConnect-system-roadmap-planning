# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local PostgreSQL (offline mode). Points at the barangay computer's own DB
# when deployed; leave as-is during development.
DATABASE_URL=postgresql://postgres:password@localhost:5432/barangayconnect

# Local file storage for uploads (defaults to <project>/storage)
LOCAL_STORAGE_DIR=

# Barangay Info (White-label)
NEXT_PUBLIC_BARANGAY_NAME="Barangay Example"
NEXT_PUBLIC_MUNICIPALITY="Municipality"
NEXT_PUBLIC_PROVINCE="Province"
NEXT_PUBLIC_REGION="Region"
NEXT_PUBLIC_CONTACT="(0XX) XXX-XXXX"
NEXT_PUBLIC_EMAIL="barangay@example.gov.ph"
NEXT_PUBLIC_CAPTAIN_NAME="Hon. Juan Dela Cruz"
NEXT_PUBLIC_MOTTO="Serbisyong Tapat, Mamamayan Masaya"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifications (Gmail SMTP). Leave SMTP_PASS empty to run offline (no
# emails sent; notifications stay queued in the database instead).
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
# Google -> Account -> Security -> 2-Step Verification -> App passwords -> 16-char code
SMTP_PASS=
